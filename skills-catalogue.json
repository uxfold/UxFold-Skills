{
  "$comment": "New Project picker. House defaults stay as marked. Every KKD pack and every KKD sub-skill is optional add-only: default off, visibility search-only. Lab must not dump the leaf list into the default tick panel. Search name/description/tags and show matches as options the designer can tick.",
  "version": 3,
  "picker": {
    "rule": "Optional add-only. Nothing KKD is ticked on a new project. The default panel does not list KKD packs or sub-skills. The designer searches; matching packs, plugins, flow skills, and leaf skills appear as ticks they can choose.",
    "defaultPanelExcludes": ["kkd-flow", "kkd-inclusive", "kkd-practice"],
    "searchIndex": ["name", "description", "group", "parent", "copiesFrom", "tags"],
    "searchOnlyFiles": ["kkd-leaf-skills.json", "kkd-leaf-inclusive.json", "kkd-leaf-practice.json"],
    "searchHints": ["kkd", "kkd-flow", "kkd-inc", "kkd-prac", "grill", "inclusive", "a11y", "tokens", "critique"]
  },
  "alsoLoad": ["kkd-leaf-skills.json"],
  "entries": [
    {"name": "uxfold-core", "description": "House rules for the agent: use design tokens first, reuse existing components, keep the preview working.", "repo": "local:skills/uxfold-core", "install": "copy skills/uxfold-core to .agents/skills/uxfold-core and .claude/skills/uxfold-core", "default": "on", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-principles", "description": "Aesthetic-usability, Pareto, heuristics, Parkinson, pattern catalogues, desirability / feasibility / scale.", "repo": "local:skills/uxfold-principles", "install": "copy skills/uxfold-principles to .agents/skills/uxfold-principles and .claude/skills/uxfold-principles", "default": "on", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-handoff", "description": "Write a developer handoff note from the live prototype.", "repo": "local:skills/uxfold-handoff", "install": "copy skills/uxfold-handoff to .agents/skills/uxfold-handoff and .claude/skills/uxfold-handoff", "default": "on", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-ia", "description": "Build a sitemap as docs/ia.md (Mermaid) and docs/ia.drawio.", "repo": "local:skills/uxfold-ia", "install": "copy skills/uxfold-ia to .agents/skills/uxfold-ia and .claude/skills/uxfold-ia", "default": "off", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-funnel", "description": "Label screens TOFU / MOFU / BOFU (or acquire / activate / habit) and write docs/funnel.md.", "repo": "local:skills/uxfold-funnel", "install": "copy skills/uxfold-funnel to .agents/skills/uxfold-funnel and .claude/skills/uxfold-funnel", "default": "off", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-moscow", "description": "Scope the slice with Must / Should / Could / Will-not.", "repo": "local:skills/uxfold-moscow", "install": "copy skills/uxfold-moscow to .agents/skills/uxfold-moscow and .claude/skills/uxfold-moscow", "default": "off", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-figma-push", "description": "Push screens to Figma as frames, new local components, existing local components, or a published library.", "repo": "local:skills/uxfold-figma-push", "install": "copy skills/uxfold-figma-push to .agents/skills/uxfold-figma-push and .claude/skills/uxfold-figma-push", "default": "off", "kind": "bundled", "agents": ["any"]},
    {"name": "uxfold-ux-modules", "description": "Loads only the ux-designer topics you picked. Added automatically with ux-designer.", "repo": "local:skills/uxfold-ux-modules", "install": "copy skills/uxfold-ux-modules to .agents/skills/uxfold-ux-modules and .claude/skills/uxfold-ux-modules", "default": "off", "kind": "bundled", "agents": ["any"]},
    {"name": "superpowers", "description": "A steady way of working: brainstorm, plan, test first, and check before saying done.", "repo": "https://github.com/obra/superpowers", "install": "/plugin install superpowers@claude-plugins-official", "default": "on", "kind": "plugin", "agents": ["claude-code"]},
    {"name": "claude-mem", "description": "Remembers past sessions, so the agent does not have to relearn your project each time.", "repo": "https://github.com/thedotmack/claude-mem", "install": "/plugin marketplace add thedotmack/claude-mem && /plugin install claude-mem@thedotmack", "default": "on", "kind": "plugin", "agents": ["claude-code"]},
    {"name": "frontend-design", "description": "Anthropic's skill for distinctive, polished frontends that avoid a generic AI look.", "repo": "https://github.com/anthropics/skills", "install": "npx skills add anthropics/skills --skill frontend-design", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "design-taste-frontend", "description": "Stops generic AI UI. Variance, motion, and density dials.", "repo": "https://github.com/Leonxlnx/taste-skill", "install": "npx skills add https://github.com/Leonxlnx/taste-skill --skill design-taste-frontend", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "web-design-guidelines", "description": "Audit UI against Vercel web interface guidelines (a11y, forms, motion, type).", "repo": "https://github.com/vercel-labs/agent-skills", "install": "npx skills add https://github.com/vercel-labs/agent-skills --skill web-design-guidelines", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "writing-guidelines", "description": "Audit docs and prose against Vercel writing guidelines.", "repo": "https://github.com/vercel-labs/agent-skills", "install": "npx skills add https://github.com/vercel-labs/agent-skills --skill writing-guidelines", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "ux-writing", "description": "Clear microcopy for buttons, errors, empty states and tone of voice.", "repo": "https://github.com/content-designer/ux-writing-skill", "install": "npx skills add content-designer/ux-writing-skill", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "ux-designer", "description": "Broad UX know-how in topic modules. Pick the topics you want below.", "repo": "https://github.com/szilu/ux-designer-skill", "install": "npx skills add szilu/ux-designer-skill", "default": "off", "kind": "skill", "agents": ["any"], "modulesFile": "ux-designer-modules.json"},
    {"name": "ponytail", "description": "Do less. Reuse what exists, native controls before new libraries.", "repo": "https://github.com/DietrichGebert/ponytail", "install": "npx skills add DietrichGebert/ponytail", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "image-to-code", "description": "Turn a screenshot or reference image into matching frontend code.", "repo": "https://github.com/Leonxlnx/taste-skill", "install": "npx skills add https://github.com/Leonxlnx/taste-skill --skill image-to-code", "default": "off", "kind": "skill", "agents": ["any"]},
    {"name": "playwright-cli", "description": "Lets the agent check your preview in a browser: take snapshots and screenshots, and click through it.", "repo": "https://github.com/microsoft/playwright-cli", "install": "npm i -g @playwright/cli@latest && playwright-cli install --skills", "default": "off", "kind": "cli-skill", "agents": ["any"]},
    {"name": "kkd-design-flow-pack", "description": "KKD design process pack: 8 skills from brief to review. Or search to add single skills.", "repo": "https://github.com/uxfold/designer-skills-KKD", "install": "npx skills add uxfold/designer-skills-KKD", "default": "off", "kind": "skill", "agents": ["any"], "group": "kkd-flow", "searchable": true, "optional": true, "visibility": "search-only", "addOnly": true, "tags": ["kkd", "optional", "kkd-flow"]},
    {"name": "kkd-inclusive-design-pack", "description": "KKD inclusive design pack: 6 plugins for accessible, adaptive design. Or search to add single plugins.", "repo": "https://github.com/uxfold/KKD-inclusive-design-skills", "install": "/plugin marketplace add uxfold/KKD-inclusive-design-skills", "default": "off", "kind": "plugin", "agents": ["claude-code"], "group": "kkd-inclusive", "searchable": true, "optional": true, "visibility": "search-only", "addOnly": true, "tags": ["kkd", "optional", "kkd-inclusive"]},
    {"name": "kkd-designer-practice-pack", "description": "KKD design practice pack: 9 plugins for research, systems, critique and more. Or search to add single plugins.", "repo": "https://github.com/uxfold/KKD-designer-skills", "install": "/plugin marketplace add uxfold/KKD-designer-skills", "default": "off", "kind": "plugin", "agents": ["claude-code"], "group": "kkd-practice", "searchable": true, "optional": true, "visibility": "search-only", "addOnly": true, "tags": ["kkd", "optional", "kkd-practice"]},
    {"name": "kkd-flow-design-flow", "description": "Run the full KKD design sequence, skip phases you do not need.", "repo": "https://github.com/uxfold/designer-skills-KKD", "install": "npx skills add uxfold/designer-skills-KKD --skill design-flow", "default": "off", "kind": "skill", "agents": ["any"], "group": "kkd-flow", "searchable": true, "optional": true, "parent": "kkd-design-flow-pack", "copiesFrom": "design-flow", "visibility": "search-only", "addOnly": true, "tags": ["kkd", "optional", "kkd-flow"]},
    {"name": "kkd-flow-grill-me", "description": "Interrogate the plan until design decisions are resolved.", "repo": "https://github.com/uxfold/designer-skills-KKD", "install": "npx skills add uxfold/designer-skills-KKD --skill grill-me", "default": "off", "kind": "skill", "agents": ["any"], "group": "kkd-flow", "searchable": true, "optional": true, "parent": "kkd-design-flow-pack", "copiesFrom": "grill-me", "visibility": "search-only", "addOnly": true, "tags": ["kkd", "optional", "kkd-flow"]},
    {"name": "kkd-flow-design-brief", "description": "Turn the grilling session into a structured brief.", "repo": "https://github.com/uxfold/designer-skills-KKD", "install": "npx skills add uxfold/designer-skills-KKD --skill design-brief", "default": "off", "kind": "skill", "agents": ["any"], "group": "kkd-flow", "searchable": true, "optional": true, "parent": "kkd-design-flow-pack", "copiesFrom": "design-brief", "visibility": "search-only", "addOnly": true, "tags": ["kkd", "optional", "kkd-flow"]},
